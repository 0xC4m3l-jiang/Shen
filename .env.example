# 蜃楼 Shen · Docker Compose 环境文件模板
#
# 用法：复制为 .env（.env 已被 .gitignore 忽略，不会入库），按需修改后在仓库根执行 `docker compose up -d --build`。
#   Linux / macOS：cp .env.example .env
#   Windows      ：Copy-Item .env.example .env
#   或直接用 scripts/shen.sh up / scripts/shen.ps1 up：首次会自动生成 .env 并填好随机口令与令牌。
#
# 取值优先级（高 → 低）：命令行所在 shell 的环境变量 > 本文件 > compose.yaml 里的 ${VAR:-默认值}。
# 本文件只放**非生产**默认值；生产密钥走 deploy/docker/compose.prod.yaml 的 secrets（文件），不要写在这里。

# ── Compose 自身 ──────────────────────────────────────────────────────────────
# 路径分隔符显式设为分号：Windows 路径里有冒号（C:\），分号在三种系统上行为一致。
COMPOSE_PATH_SEPARATOR=;
# 要叠加的文件（第一个必须是根目录的 compose.yaml —— 它决定项目目录与相对路径的基准）：
#   默认（构建好的前端，接近生产形态）：compose.yaml
#   开发（Vite 热更新 + 调试端口）      ：compose.yaml;deploy/docker/compose.dev.yaml
#   验证（非影子，改道 / 诱饵真实执行）  ：compose.yaml;deploy/docker/compose.verify-mirage.yaml
COMPOSE_FILE=compose.yaml
# 要启动的模块（逗号分隔）。all = 全部；也可组合：frontend / backend / honeypot / analysis / deception / console / demo。
# 只想单独起某个模块时：临时清空本项再加 --profile（见 deploy/docker/README.md「按模块启动」）。
COMPOSE_PROFILES=all

# ── 宿主端口（容器内端口固定；默认只绑本机回环）────────────────────────────────
SHEN_BIND_ADDR=127.0.0.1
SHEN_HTTP_PORT=18080
SHEN_CONSOLE_PORT=19444
# 仅开发叠加文件发布：
SHEN_CONSOLE_API_PORT=19445
SHEN_HONEYPOT_PORT=19090

# ── 管控台（console-api）──────────────────────────────────────────────────────
# 浏览器 Origin 白名单：改了 SHEN_CONSOLE_PORT 或经反向代理访问时同步修改。
SHEN_CONSOLE_ALLOWED_ORIGINS=http://127.0.0.1:19444,http://localhost:19444
SHEN_CONSOLE_BOOTSTRAP_USER=admin
# 初始管理员口令。默认 admin（验证环境开箱即用，首登强制改密）。
# 可选：random = 随机生成并写入容器 /data/bootstrap-admin.txt（docker compose exec console-api cat /data/bootstrap-admin.txt）；
#       或直接设为 ≥12 位强口令。生产环境必须用 compose.prod.yaml 的 secrets 注入，不要依赖默认值。
SHEN_CONSOLE_BOOTSTRAP_PASSWORD=admin
# 只读自动化令牌（≥24 位；scripts/traffic、scripts/doctor 用它读 /api/v1）。留空 = 不启用。
SHEN_CONSOLE_API_TOKEN=
SHEN_CONSOLE_COOKIE_SECURE=false

# ── 引擎 ─────────────────────────────────────────────────────────────────────
# 被保护的业务地址（默认指向演示假业务站；换成你的真实业务并去掉 demo profile）。
SHEN_PROXY_UPSTREAM=http://127.0.0.1:19080
# 首次上线必须影子模式（只观测、不处置）。
SHEN_PROXY_SHADOW=true
SHEN_CORE_CONFIG=./deploy/config/config.example.yaml

# ── 蜜罐（honeypot-web）──────────────────────────────────────────────────────
SHEN_WEB_SCENARIO=contoso
SHEN_WEB_SCENARIOS_FILE=./deploy/config/scenarios.example.json

# ── 镜像命名 ─────────────────────────────────────────────────────────────────
# 开发 / 默认留空即可（= shen/*:dev）。生产叠加文件要求**显式**设置（如 registry.example.com/shen 与 1.4.2），
# 这里不预填，避免把 dev 镜像误当生产版本发布。
# SHEN_IMAGE_PREFIX=registry.example.com/shen
# SHEN_VERSION=1.4.2
# 开发叠加文件：绑定挂载下是否用轮询监听源码变化（Windows / macOS 建议 true）。
SHEN_VITE_POLLING=true
