# 方式一（独立连接器进程）的环境配置模板。
# 用法：复制为 connector.env，填入控制台「接入管理」签发的凭证后：
#   set -a; . ./connector.env; set +a; shen-connector
# 或直接运行 ../demo/up.sh（脚本自动完成签发与本文件的填空）。

# 连接器网关地址（host:port）。
#   本地栈（scripts/dev.sh）：127.0.0.1:9446
#   compose 栈：宿主发布端口（.env 的 SHEN_GATEWAY_PORT，默认 19446）
SHEN_CONNECTOR_GATEWAY=127.0.0.1:9446

# 接入凭证（控制台「接入管理」签发，shc- 开头，明文只显示一次）。
SHEN_CONNECTOR_KEY=

# 本地真实业务地址（业务只听回环即可——零入站暴露）。
SHEN_CONNECTOR_UPSTREAM=http://127.0.0.1:9001

# 服务名（与凭证签发时一致；连接器不得改名）。
SHEN_CONNECTOR_NAME=蜃景商城

# 声明域名（逗号分隔；必须是凭证域名白名单的子集）。
SHEN_CONNECTOR_HOSTS=demo.shop.local

# 自签证书仅本地开发（true = 跳过证书校验）；生产必须删除。
SHEN_CONNECTOR_TLS_INSECURE=true
